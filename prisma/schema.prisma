generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PREMIUM
}

enum RifaStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  DRAWN
  CANCELLED
}

enum NumStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum TransStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum EarnStatus {
  PENDING
  PAID
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  password  String
  verified  Boolean  @default(false)
  verifyCode String?
  role      String   @default("user")
  plan      Plan     @default(FREE)
  mpAccountId String?
  pushToken String?
  createdAt DateTime @default(now())

  rifas      Rifa[]
  affiliates Affiliate[]
  earnings   AffiliateEarning[]
}

model Rifa {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  description     String?
  imageUrl        String?
  pricePerNumber  Decimal    @db.Decimal(12,2)
  totalNumbers    Int
  startDate       DateTime   @default(now())
  drawDate        DateTime
  status          RifaStatus @default(DRAFT)
  winnerNumber    Int?
  winnerName      String?
  commissionRate  Decimal    @default(0.03)
  allowAffiliates Boolean    @default(false)
  colors          Json?
  category        String?
  aliasCbu        String?
  createdAt       DateTime   @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  numbers      Number[]
  transactions Transaction[]
  affiliates   Affiliate[]

  @@index([slug])
  @@index([userId])
  @@index([status])
}

model Number {
  id         String    @id @default(cuid())
  number     Int
  status     NumStatus @default(AVAILABLE)
  buyerName  String?
  buyerPhone String?
  buyerEmail String?
  reservedAt DateTime?
  paidAt     DateTime?

  rifaId String
  rifa   Rifa @relation(fields: [rifaId], references: [id])

  soldBy String?
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@unique([rifaId, number])
  @@index([rifaId, status])
  @@index([transactionId])
}

model Transaction {
  id             String      @id @default(cuid())
  mpPreferenceId String?     @unique
  mpPaymentId    String?     @unique
  amount         Decimal     @db.Decimal(12,2)
  commission     Decimal     @db.Decimal(12,2)
  netAmount      Decimal     @db.Decimal(12,2)
  status         TransStatus @default(PENDING)
  buyerName      String
  buyerPhone     String?
  buyerEmail     String?
  createdAt      DateTime    @default(now())

  rifaId  String
  rifa    Rifa     @relation(fields: [rifaId], references: [id])

  numbers  Number[]
  earnings AffiliateEarning[]

  @@index([mpPaymentId])
  @@index([rifaId])
}

model Affiliate {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  commissionRate Decimal  @default(0.10)
  referralCode   String   @unique
  createdAt      DateTime @default(now())

  rifaId String
  rifa   Rifa @relation(fields: [rifaId], references: [id])

  userId String
  user   User @relation(fields: [userId], references: [id])

  earnings AffiliateEarning[]
}

model AffiliateEarning {
  id            String    @id @default(cuid())
  amount        Decimal   @db.Decimal(12,2)
  status        EarnStatus @default(PENDING)
  createdAt     DateTime  @default(now())

  affiliateId   String
  affiliate     Affiliate      @relation(fields: [affiliateId], references: [id])
  transactionId String?
  transaction   Transaction?   @relation(fields: [transactionId], references: [id])
  userId        String
  user          User           @relation(fields: [userId], references: [id])
}
